---
/**
 * Contact Form Section
 * Форма заявки на консультацию
 * С валидацией и обработкой отправки
 * Отправляет данные в Yandex Cloud Function → Telegram
 */

// Yandex Cloud Function endpoint
const FORM_ENDPOINT = "https://d5d4gu7upurn7ol2iv15.ubofext2.apigw.yandexcloud.net/submit";
---

<section class="contact" id="contact">
  <div class="contact__container">
    <div class="contact__content">
      <h2 class="contact__title">
        Оставьте заявку<br />на консультацию
      </h2>
      <p class="contact__description">
        Мы разберем ваш случай и подберем подходящую программу
      </p>
    </div>
    
    <form class="contact__form" id="contactForm" novalidate data-endpoint={FORM_ENDPOINT}>
      
      <div class="contact__fields">
        <div class="contact__field">
          <label class="contact__label" for="name">Имя</label>
          <input 
            type="text" 
            id="name"
            name="name"
            placeholder="Иван Иванов"
            class="contact__input"
            required
            minlength="2"
          />
          <span class="contact__error" id="nameError"></span>
        </div>
        
        <div class="contact__field">
          <label class="contact__label" for="email">Email</label>
          <input 
            type="email" 
            id="email"
            name="email"
            placeholder="mail@yandex.ru"
            class="contact__input"
            required
          />
          <span class="contact__error" id="emailError"></span>
        </div>
        
        <div class="contact__field">
          <label class="contact__label" for="phone">Номер телефона</label>
          <input 
            type="tel" 
            id="phone"
            name="phone"
            placeholder="+7 (___) ___-__-__"
            class="contact__input"
            required
          />
          <span class="contact__error" id="phoneError"></span>
        </div>
      </div>
      
      <div class="contact__checkbox">
        <input 
          type="checkbox" 
          id="consent"
          name="consent"
          class="contact__checkbox-input"
          required
        />
        <label class="contact__checkbox-label" for="consent">
          Я согласен на обработку <a href="/privacy" target="_blank">персональных данных</a>
        </label>
      </div>
      
      <button type="submit" class="contact__submit" id="submitBtn">
        <span class="contact__submit-text">Отправить</span>
        <span class="contact__submit-loading">
          <svg class="contact__spinner" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-dasharray="31.4 31.4" />
          </svg>
          Отправка...
        </span>
      </button>
      
      <!-- Success Message -->
      <div class="contact__message contact__message--success" id="successMessage">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
          <path d="M8 12L11 15L16 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>Заявка успешно отправлена! Мы свяжемся с вами в ближайшее время.</span>
      </div>
      
      <!-- Error Message -->
      <div class="contact__message contact__message--error" id="errorMessage">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
          <path d="M12 8V12M12 16H12.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <span>Произошла ошибка. Попробуйте ещё раз или свяжитесь с нами по телефону.</span>
      </div>
    </form>
  </div>
</section>

<style>
  .contact {
    background: var(--color-bg);
    padding: 50px 20px;
  }

  @media (min-width: 768px) {
    .contact {
      padding: 80px 50px;
    }
  }

  .contact__container {
    max-width: 1309px;
    margin: 0 auto;
    background: white;
    border-radius: 32px;
    padding: 24px;
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .contact__container {
      padding: 40px;
    }
  }

  @media (min-width: 1024px) {
    .contact__container {
      grid-template-columns: 1fr 600px;
      gap: 4rem;
      padding: 50px;
    }
  }

  .contact__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact__title {
    color: var(--color-dark);
    font-size: clamp(36px, 5vw, 65px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0;
  }

  .contact__description {
    color: var(--color-text);
    font-size: 1.125rem;
    line-height: 1.17;
    margin: 0;
    max-width: 371px;
  }

  @media (min-width: 768px) {
    .contact__description {
      font-size: 1.25rem;
    }
  }

  /* Form */
  .contact__form {
    background: #F8F9FA;
    border-radius: 32px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .contact__fields {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .contact__field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .contact__label {
    color: #98979C;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.1;
  }

  .contact__input {
    width: 100%;
    padding: 16px;
    background: #F8F9FA;
    border: 1px solid rgba(169, 169, 169, 0.5);
    border-radius: 16px;
    color: black;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.1;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .contact__input::placeholder {
    color: rgba(0, 0, 0, 0.5);
  }

  .contact__input:focus {
    border-color: var(--color-primary);
  }

  .contact__input.error {
    border-color: #E53935;
  }

  .contact__error {
    color: #E53935;
    font-size: 12px;
    font-weight: 400;
    min-height: 16px;
    display: block;
  }

  /* Checkbox */
  .contact__checkbox {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .contact__checkbox-input {
    width: 20px;
    height: 20px;
    margin: 0;
    flex-shrink: 0;
    accent-color: var(--color-primary);
    cursor: pointer;
  }

  .contact__checkbox-label {
    color: #98979C;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.3;
    cursor: pointer;
  }

  .contact__checkbox-label a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  /* Submit Button */
  .contact__submit {
    width: 100%;
    padding: 24px;
    background: var(--color-primary);
    color: white;
    font-size: 16px;
    font-weight: 400;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .contact__submit:hover:not(:disabled) {
    background: var(--color-primary-hover);
  }

  .contact__submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .contact__submit-loading {
    display: none;
    align-items: center;
    gap: 8px;
  }

  .contact__submit.loading .contact__submit-text {
    display: none;
  }

  .contact__submit.loading .contact__submit-loading {
    display: flex;
  }

  .contact__spinner {
    width: 20px;
    height: 20px;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Messages */
  .contact__message {
    display: none;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    border-radius: 16px;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.3;
  }

  .contact__message.visible {
    display: flex;
  }

  .contact__message svg {
    flex-shrink: 0;
  }

  .contact__message--success {
    background: #E8F5E9;
    color: #2E7D32;
  }

  .contact__message--error {
    background: #FFEBEE;
    color: #C62828;
  }

  /* Hide form after success */
  .contact__form.success .contact__fields,
  .contact__form.success .contact__checkbox,
  .contact__form.success .contact__submit {
    display: none;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contactForm') as HTMLFormElement;
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
    const successMessage = document.getElementById('successMessage');
    const errorMessage = document.getElementById('errorMessage');
    
    // Input elements
    const nameInput = document.getElementById('name') as HTMLInputElement;
    const emailInput = document.getElementById('email') as HTMLInputElement;
    const phoneInput = document.getElementById('phone') as HTMLInputElement;
    const consentInput = document.getElementById('consent') as HTMLInputElement;
    
    // Error elements
    const nameError = document.getElementById('nameError');
    const emailError = document.getElementById('emailError');
    const phoneError = document.getElementById('phoneError');

    // Phone mask
    phoneInput.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      let value = target.value.replace(/\D/g, '');
      
      if (value.startsWith('8')) {
        value = '7' + value.slice(1);
      }
      
      if (value.length > 0) {
        if (value.length <= 1) {
          value = '+7 (' + value.slice(1);
        } else if (value.length <= 4) {
          value = '+7 (' + value.slice(1);
        } else if (value.length <= 7) {
          value = '+7 (' + value.slice(1, 4) + ') ' + value.slice(4);
        } else if (value.length <= 9) {
          value = '+7 (' + value.slice(1, 4) + ') ' + value.slice(4, 7) + '-' + value.slice(7);
        } else {
          value = '+7 (' + value.slice(1, 4) + ') ' + value.slice(4, 7) + '-' + value.slice(7, 9) + '-' + value.slice(9, 11);
        }
      }
      
      target.value = value;
    });

    // Validation functions
    const validateName = (): boolean => {
      const value = nameInput.value.trim();
      if (!value) {
        nameInput.classList.add('error');
        if (nameError) nameError.textContent = 'Введите имя';
        return false;
      }
      if (value.length < 2) {
        nameInput.classList.add('error');
        if (nameError) nameError.textContent = 'Имя слишком короткое';
        return false;
      }
      nameInput.classList.remove('error');
      if (nameError) nameError.textContent = '';
      return true;
    };

    const validateEmail = (): boolean => {
      const value = emailInput.value.trim();
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!value) {
        emailInput.classList.add('error');
        if (emailError) emailError.textContent = 'Введите email';
        return false;
      }
      if (!emailRegex.test(value)) {
        emailInput.classList.add('error');
        if (emailError) emailError.textContent = 'Некорректный email';
        return false;
      }
      emailInput.classList.remove('error');
      if (emailError) emailError.textContent = '';
      return true;
    };

    const validatePhone = (): boolean => {
      const value = phoneInput.value.replace(/\D/g, '');
      if (!value) {
        phoneInput.classList.add('error');
        if (phoneError) phoneError.textContent = 'Введите номер телефона';
        return false;
      }
      if (value.length < 11) {
        phoneInput.classList.add('error');
        if (phoneError) phoneError.textContent = 'Номер слишком короткий';
        return false;
      }
      phoneInput.classList.remove('error');
      if (phoneError) phoneError.textContent = '';
      return true;
    };

    // Real-time validation
    nameInput.addEventListener('blur', validateName);
    emailInput.addEventListener('blur', validateEmail);
    phoneInput.addEventListener('blur', validatePhone);

    // Form submission
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Validate all fields
      const isNameValid = validateName();
      const isEmailValid = validateEmail();
      const isPhoneValid = validatePhone();
      
      if (!consentInput.checked) {
        alert('Необходимо согласие на обработку персональных данных');
        return;
      }
      
      if (!isNameValid || !isEmailValid || !isPhoneValid) {
        return;
      }
      
      // Show loading state
      submitBtn.classList.add('loading');
      submitBtn.disabled = true;
      errorMessage?.classList.remove('visible');
      
      try {
        const endpoint = form.dataset.endpoint || '';
        
        const data = {
          name: nameInput.value.trim(),
          email: emailInput.value.trim(),
          phone: phoneInput.value.trim()
        };
        
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(data)
        });
        
        const result = await response.json();
        
        if (result.success) {
          // Show success
          form.classList.add('success');
          successMessage?.classList.add('visible');
          
          // Reset form
          form.reset();
        } else {
          throw new Error(result.error || 'Form submission failed');
        }
      } catch (error) {
        // Show error
        errorMessage?.classList.add('visible');
        console.error('Form error:', error);
      } finally {
        submitBtn.classList.remove('loading');
        submitBtn.disabled = false;
      }
    });
  });
</script>
