---
/**
 * Experts Section
 * Наши эксперты - 3 карточки специалистов
 */

const experts = [
  {
    name: 'Олег Гаас',
    role: 'Гипнолог, психолог-консультант, сертифицированный специалист по ДПДГ и ведущий курсов по директивному, классическому и регрессивному гипнозу, доцент',
    description: 'Изучает человеческие рефлексы, мысли и эмоции. Помогает клиентам понять свои внутренние проблемы, преодолеть зависимости и решить задачи в кратчайшие сроки',
    badges: ['Глубокие знания нейро-физиологии'],
    image: '/images/experts/expert-oleg.png',
    lightBg: true, // Светлый фон — нужен градиент
  },
  {
    name: 'Алёна Любочко',
    role: 'Психолог-консультант, гипнолог, специалист по глубокой регрессии, проводник в прошлые жизни и к духовному наставнику, преподаватель',
    description: 'Специалист, который поможет вам преодолеть жизненные трудности, найти причину неудовлетворённости, разобраться в себе и встать на свой жизненный путь',
    badges: ['Большой опыт погружения в гипноз', 'Исследование трансовых состояний с 17 лет'],
    image: '/images/experts/expert-alena.png',
    lightBg: false,
  },
  {
    name: 'Ваагн Хачатрян',
    role: 'Врач-физиотерапевт с 20-летним стажем, реабилитолог, суггестивный психолог: сертифицированный гипнотерапевт (классический и регрессивный гипноз)',
    description: 'Опыт работы в военной и гражданской медицине в сфере неврологии, ревматологии, травматологии и психического здоровья. Большой опыт работы с особыми детьми: ДЦП, аутизм',
    badges: [],
    image: '/images/experts/expert-vaagn.png',
    lightBg: false,
  },
]
---

<section class="experts" id="experts">
  <div class="container">
    <h2 class="experts__title">Наши эксперты</h2>
    
    <div class="experts__grid">
      {experts.map((expert) => (
        <article class={`expert-card ${expert.lightBg ? 'expert-card--light-bg' : ''}`}>
          <!-- Фото на весь фон -->
          <img 
            src={expert.image} 
            alt={expert.name}
            class="expert-card__image"
            loading="lazy"
          />
          
          <!-- Контент сверху -->
          <div class="expert-card__header">
            <h3 class="expert-card__name">{expert.name}</h3>
            <p class="expert-card__role">{expert.role}</p>
          </div>
          
          <!-- Бейджи (если есть) -->
          {expert.badges.length > 0 && (
            <div class="expert-card__badges">
              {expert.badges.map((badge) => (
                <span class="expert-card__badge">{badge}</span>
              ))}
            </div>
          )}
          
          <!-- Описание внизу -->
          <div class="expert-card__footer">
            <p class="expert-card__description">{expert.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .experts {
    background: var(--color-bg);
    padding: 80px 0;
  }

  .experts__title {
    color: var(--color-text);
    font-size: clamp(40px, 5vw, 65px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0 0 2rem;
    text-align: center;
  }

  @media (min-width: 768px) {
    .experts__title {
      text-align: left;
    }
  }

  .experts__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .experts__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .experts__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Expert Card */
  .expert-card {
    border-radius: 32px;
    padding: 10px; /* Отступы 10px от краёв */
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    min-height: 500px;
  }

  @media (min-width: 768px) {
    .expert-card {
      min-height: 538px;
    }
  }

  /* Фото на весь фон */
  .expert-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    z-index: 0;
    border-radius: 32px;
  }

  /* Хедер с именем и ролью */
  .expert-card__header {
    position: relative;
    z-index: 1;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* Для карточек со светлым фоном — добавляем градиент */
  .expert-card--light-bg .expert-card__header {
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.4) 0%,
      rgba(0, 0, 0, 0.2) 60%,
      transparent 100%
    );
    margin: -10px -10px 0;
    padding: 20px;
    border-radius: 32px 32px 0 0;
  }

  /* Тень под текстом для лучшей читаемости */
  .expert-card--light-bg .expert-card__name,
  .expert-card--light-bg .expert-card__role {
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
  }

  .expert-card__name {
    color: white;
    font-size: clamp(28px, 3vw, 38px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0;
  }

  .expert-card__role {
    color: rgba(255, 255, 255, 0.85);
    font-size: 12px;
    font-weight: 300;
    line-height: 1.17;
    margin: 0;
    max-width: 373px;
  }

  /* Бейджи */
  .expert-card__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    padding: 0 6px;
    position: relative;
    z-index: 1;
  }

  .expert-card__badge {
    display: inline-flex;
    align-items: center;
    padding: 16px;
    /* Liquid Glass Effect */
    background: linear-gradient(
      135deg,
      rgba(103, 82, 70, 0.35) 0%,
      rgba(103, 82, 70, 0.2) 50%,
      rgba(103, 82, 70, 0.3) 100%
    );
    backdrop-filter: blur(75px) saturate(180%);
    -webkit-backdrop-filter: blur(75px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 
      0 4px 16px rgba(0, 0, 0, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.15);
    border-radius: 20px;
    color: white;
    font-size: 12px;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  /* Футер с описанием */
  .expert-card__footer {
    background: white;
    border-radius: 24px;
    padding: 12px;
    margin-top: auto;
    position: relative;
    z-index: 1;
  }

  /* Если нет бейджей — добавляем отступ сверху */
  .expert-card__badges + .expert-card__footer {
    margin-top: 10px;
  }

  .expert-card__description {
    color: var(--color-text-secondary);
    font-size: 16px;
    line-height: 1.25;
    margin: 0;
  }
</style>
