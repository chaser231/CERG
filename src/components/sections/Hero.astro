---
/**
 * Hero Section — Bento-style layout
 * Динамическая система: кнопки фиксированного размера
 * Вырезы реализованы через overlay-элементы (не SVG маску)
 */

const navItems = [
  { label: 'О центре', href: '#about' },
  { label: 'Услуги', href: '#services' },
  { label: 'Отзывы', href: '#reviews' },
  { label: 'Эксперты', href: '#experts' },
  { label: 'Цены', href: '#courses' },
  { label: 'Частые вопросы', href: '#faq' },
  { label: 'Контакты', href: '#contact' },
]
---

<section class="hero">
  <!-- Background Image Container -->
  <div class="hero__image-wrap">
    <div class="hero__image-container">
      <img 
        src="/images/hero/image 35261.png" 
        alt="3D логотип ЦЕРГ" 
        class="hero__image"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    
    <!-- Cutout overlays - positioned absolutely, create the "notch" effect -->
    <div class="hero__cutout hero__cutout--top-right"></div>
    <div class="hero__cutout hero__cutout--bottom-left"></div>
    
    <!-- Title Block (inside image area) -->
    <div class="hero__title-block">
      <div class="hero__title-row">
        <h1 class="hero__title">Центр</h1>
        <div class="hero__logo">
          <img src="/images/logo.png" alt="ЦЕРГ" class="hero__logo-img" />
        </div>
      </div>
      <h1 class="hero__title">регрессивного</h1>
      <h1 class="hero__title">гипноза</h1>
    </div>
    
    <!-- CTA Button (positioned in bottom-left cutout) -->
    <a href="#contact" class="hero__cta-btn">
      <span class="hero__btn-text hero__btn-text--dark">
        Записаться<br />на консультацию
      </span>
      <div class="hero__btn-icon hero__btn-icon--dark">
        <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
          <path d="M1 12L12 1M12 1H3M12 1V10" stroke="currentColor" stroke-width="2"/>
        </svg>
      </div>
    </a>
    
    <!-- Feedback Button (positioned in top-right cutout) -->
    <a href="#contact" class="hero__feedback-btn">
      Связаться с нами
    </a>
    
    <!-- Navigation Pills (desktop) -->
    <nav class="hero__nav">
      {navItems.map((item) => (
        <a href={item.href} class="hero__nav-link">{item.label}</a>
      ))}
    </nav>
    
    <!-- Menu Button (tablet/mobile) -->
    <button class="hero__menu-btn" type="button" aria-label="Открыть меню" id="menuToggle">
      <span class="hero__menu-btn-text">Меню</span>
      <svg class="hero__menu-icon hero__menu-icon--burger" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="4" y1="8" x2="20" y2="8" />
        <line x1="4" y1="13" x2="20" y2="13" />
        <line x1="4" y1="18" x2="20" y2="18" />
      </svg>
      <svg class="hero__menu-icon hero__menu-icon--close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="6" y1="6" x2="18" y2="18" />
        <line x1="6" y1="18" x2="18" y2="6" />
      </svg>
    </button>
    
    <!-- Mobile Menu Dropdown -->
    <nav class="hero__mobile-menu" id="mobileMenu">
      <div class="hero__mobile-menu-content">
        {navItems.map((item) => (
          <a href={item.href} class="hero__mobile-menu-link">{item.label}</a>
        ))}
      </div>
    </nav>
  </div>

  <!-- Right side container: Description + Learn More -->
  <div class="hero__right-block">
    <div class="hero__description">
      <p>
        Помогаем адаптировать психические и физические реакции к негативным раздражителям 
        в повседневной жизни, что приводит к внутреннему равновесию и здоровому пофигизму
      </p>
    </div>

    <a href="#training" class="hero__learn-btn">
      <span class="hero__btn-text">
        Узнать<br />об обучении
      </span>
      <div class="hero__btn-icon">
        <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
          <path d="M1 12L12 1M12 1H3M12 1V10" stroke="currentColor" stroke-width="2"/>
        </svg>
      </div>
    </a>
  </div>
</section>

<style>
  /* ================================================ */
  /* BASE STYLES                                      */
  /* ================================================ */
  .hero {
    /* Фиксированные размеры кнопок */
    --cta-width: 388px;
    --cta-height: 79px;
    --feedback-width: 206px;
    --feedback-height: 49px;
    
    /* Отступы */
    --hero-padding: 50px;
    --btn-gap: 8px;
    --radius: 32px;
    --radius-sm: 24px;
    
    /* Цвет фона для вырезов */
    --bg-color: #2A2624;
    
    position: relative;
    width: 100%;
    min-height: 100vh;
    background: var(--bg-color);
    padding: var(--hero-padding);
    padding-bottom: calc(var(--hero-padding) + 20px);
  }

  /* ================================================ */
  /* IMAGE WRAPPER                                    */
  /* ================================================ */
  .hero__image-wrap {
    position: relative;
    width: 100%;
    height: calc(100vh - var(--hero-padding) * 2 - 20px);
    min-height: 600px;
  }

  .hero__image-container {
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ================================================ */
  /* CUTOUT OVERLAYS - создают эффект вырезов         */
  /* Фиксированные размеры, позиционированы от углов  */
  /* Псевдо-элементы создают внутренние скругления    */
  /* ================================================ */
  .hero__cutout {
    position: absolute;
    background: var(--bg-color);
    z-index: 1;
  }

  /* Top-right cutout for Feedback button */
  .hero__cutout--top-right {
    top: 0;
    right: 0;
    width: calc(var(--feedback-width) + var(--btn-gap) * 2);
    height: calc(var(--feedback-height) + var(--btn-gap) * 2);
    border-bottom-left-radius: var(--radius);
  }

  /* Inner corner - bottom edge (180° rotation) */
  .hero__cutout--top-right::before {
    content: '';
    position: absolute;
    bottom: calc(-1 * var(--radius));
    right: 0;
    width: var(--radius);
    height: var(--radius);
    background: radial-gradient(circle at 0% 100%, transparent var(--radius), var(--bg-color) var(--radius));
  }

  /* Inner corner - left edge (90° rotation) */
  .hero__cutout--top-right::after {
    content: '';
    position: absolute;
    top: 0;
    left: calc(-1 * var(--radius));
    width: var(--radius);
    height: var(--radius);
    background: radial-gradient(circle at 0% 100%, transparent var(--radius), var(--bg-color) var(--radius));
  }

  /* Bottom-left cutout for CTA button */
  .hero__cutout--bottom-left {
    bottom: 0;
    left: 0;
    width: calc(var(--cta-width) + var(--btn-gap) * 2);
    height: calc(var(--cta-height) + var(--btn-gap) * 2);
    border-top-right-radius: var(--radius);
  }

  /* Inner corner - top edge (180° rotation) */
  .hero__cutout--bottom-left::before {
    content: '';
    position: absolute;
    top: calc(-1 * var(--radius));
    left: 0;
    width: var(--radius);
    height: var(--radius);
    background: radial-gradient(circle at 100% 0%, transparent var(--radius), var(--bg-color) var(--radius));
  }

  /* Inner corner - right edge (90° rotation) */
  .hero__cutout--bottom-left::after {
    content: '';
    position: absolute;
    bottom: 0;
    right: calc(-1 * var(--radius));
    width: var(--radius);
    height: var(--radius);
    background: radial-gradient(circle at 100% 0%, transparent var(--radius), var(--bg-color) var(--radius));
  }

  /* ================================================ */
  /* CTA BUTTON - фиксированный размер                */
  /* ================================================ */
  .hero__cta-btn {
    position: absolute;
    bottom: var(--btn-gap);
    left: var(--btn-gap);
    width: var(--cta-width);
    height: var(--cta-height);
    padding: 16px 20px;
    background: white;
    border-radius: var(--radius-sm);
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-decoration: none;
    z-index: 2;
    transition: all 0.2s ease;
  }

  .hero__cta-btn:hover {
    background: #f5f5f5;
  }

  /* ================================================ */
  /* FEEDBACK BUTTON - фиксированный размер           */
  /* ================================================ */
  .hero__feedback-btn {
    position: absolute;
    top: var(--btn-gap);
    right: var(--btn-gap);
    width: var(--feedback-width);
    height: var(--feedback-height);
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid white;
    border-radius: 999px;
    color: white;
    font-size: 16px;
    font-weight: 400;
    text-decoration: none;
    transition: all 0.2s ease;
    z-index: 2;
  }

  .hero__feedback-btn:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  /* ================================================ */
  /* TITLE BLOCK                                      */
  /* ================================================ */
  .hero__title-block {
    position: absolute;
    top: 30px;
    left: 30px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    z-index: 2;
  }

  .hero__title-row {
    display: flex;
    align-items: center;
    gap: 23px;
  }

  .hero__title {
    font-family: 'Roboto Flex', sans-serif;
    font-size: 65px;
    font-weight: 700;
    font-variation-settings: 'wdth' 65;
    line-height: 0.85;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: white;
    margin: 0;
  }

  .hero__logo {
    display: flex;
    align-items: center;
  }

  .hero__logo-img {
    height: 49px;
    width: auto;
  }

  /* ================================================ */
  /* RIGHT BLOCK - outside image                      */
  /* ================================================ */
  .hero__right-block {
    position: absolute;
    top: calc(var(--hero-padding) + 200px);
    right: calc(var(--hero-padding) + 24px);
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 280px;
    z-index: 2;
  }

  .hero__description {
    padding: 20px;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.15) 0%,
      rgba(255, 255, 255, 0.05) 50%,
      rgba(255, 255, 255, 0.1) 100%
    );
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: 
      0 8px 32px rgba(0, 0, 0, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
    border-radius: 20px;
  }

  .hero__description p {
    color: white;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.17;
    margin: 0;
  }

  .hero__learn-btn {
    padding: 20px;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.15) 0%,
      rgba(255, 255, 255, 0.05) 50%,
      rgba(255, 255, 255, 0.1) 100%
    );
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: 
      0 8px 32px rgba(0, 0, 0, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .hero__learn-btn:hover {
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.2) 0%,
      rgba(255, 255, 255, 0.08) 50%,
      rgba(255, 255, 255, 0.12) 100%
    );
  }

  /* ================================================ */
  /* BUTTON TEXT & ICON                               */
  /* ================================================ */
  .hero__btn-text {
    font-family: 'Roboto Flex', sans-serif;
    font-size: 28px;
    font-weight: 800;
    font-variation-settings: 'wdth' 25;
    line-height: 0.86;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: white;
  }

  .hero__btn-text--dark {
    color: black;
  }

  .hero__btn-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    color: white;
    flex-shrink: 0;
  }

  .hero__btn-icon--dark {
    width: 48px;
    height: 48px;
    background: rgba(0, 0, 0, 0.08);
    color: black;
  }

  /* ================================================ */
  /* NAVIGATION PILLS                                 */
  /* ================================================ */
  .hero__nav {
    position: absolute;
    bottom: 24px;
    right: 24px;
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 2;
  }

  .hero__nav-link {
    padding: 8px 16px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 999px;
    color: white;
    font-size: 16px;
    font-weight: 400;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .hero__nav-link:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: white;
  }

  /* ================================================ */
  /* MENU BUTTON                                      */
  /* ================================================ */
  .hero__menu-btn {
    display: none;
    position: absolute;
    bottom: var(--btn-gap);
    right: var(--btn-gap);
    padding: 8px 16px;
    background: white;
    border: 1px solid #D5D5D5;
    border-radius: 999px;
    color: black;
    font-size: 16px;
    font-weight: 400;
    cursor: pointer;
    align-items: center;
    gap: 10px;
    z-index: 10;
    transition: all 0.2s ease;
  }

  .hero__menu-btn:hover {
    background: #f5f5f5;
  }

  .hero__menu-icon--close {
    display: none;
  }

  .hero__menu-btn.active .hero__menu-icon--burger {
    display: none;
  }

  .hero__menu-btn.active .hero__menu-icon--close {
    display: block;
  }

  .hero__menu-btn.active .hero__menu-btn-text::after {
    content: 'Закрыть';
  }

  .hero__menu-btn.active .hero__menu-btn-text {
    font-size: 0;
  }

  .hero__menu-btn.active .hero__menu-btn-text::after {
    font-size: 16px;
  }

  /* ================================================ */
  /* MOBILE MENU DROPDOWN                             */
  /* ================================================ */
  .hero__mobile-menu {
    position: absolute;
    bottom: calc(var(--btn-gap) + 50px);
    right: var(--btn-gap);
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.95) 0%,
      rgba(255, 255, 255, 0.9) 100%
    );
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
    border-radius: 20px;
    padding: 12px;
    z-index: 9;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: all 0.3s ease;
  }

  .hero__mobile-menu.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .hero__mobile-menu-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .hero__mobile-menu-link {
    display: block;
    padding: 12px 20px;
    color: #2A2624;
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    border-radius: 12px;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .hero__mobile-menu-link:hover {
    background: rgba(0, 0, 0, 0.05);
  }

  /* ================================================ */
  /* RESPONSIVE: 1280px                               */
  /* ================================================ */
  @media (max-width: 1400px) {
    .hero {
      --hero-padding: 40px;
    }
    
    .hero__right-block {
      width: 260px;
    }
    
    .hero__description p {
      font-size: 18px;
    }
  }

  /* ================================================ */
  /* RESPONSIVE: 1024px - hide nav, show menu         */
  /* ================================================ */
  @media (max-width: 1279px) {
    .hero__nav {
      display: none;
    }
    
    .hero__menu-btn {
      display: flex;
    }
  }

  /* ================================================ */
  /* RESPONSIVE: TABLET 768-1023px                    */
  /* ================================================ */
  @media (max-width: 1023px) {
    .hero {
      --hero-padding: 30px;
      --cta-width: 350px;
      --cta-height: 75px;
      padding-bottom: calc(var(--hero-padding) + 60px);
    }
    
    .hero__title {
      font-size: 55px;
    }
    
    .hero__right-block {
      top: auto;
      bottom: calc(var(--cta-height) + var(--btn-gap) * 2 + 100px);
      left: calc(var(--hero-padding) + 16px);
      right: calc(var(--hero-padding) + 16px);
      width: auto;
      flex-direction: row;
    }
    
    .hero__description,
    .hero__learn-btn {
      flex: 1;
    }
    
    .hero__learn-btn {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
    
    .hero__description p {
      font-size: 16px;
    }
    
    .hero__btn-text {
      font-size: 24px;
    }
  }

  /* ================================================ */
  /* RESPONSIVE: MOBILE 480-767px                     */
  /* ================================================ */
  @media (max-width: 767px) {
    .hero {
      --hero-padding: 20px;
      --cta-width: calc(100% - 40px);
      --cta-height: 75px;
      --feedback-width: 180px;
      --feedback-height: 45px;
      min-height: auto;
      padding-bottom: calc(var(--hero-padding) + var(--cta-height) + 40px);
    }
    
    .hero__image-wrap {
      height: auto;
      min-height: 500px;
      aspect-ratio: 9 / 16;
      max-height: 70vh;
    }
    
    .hero__title {
      font-size: 42px;
    }
    
    .hero__logo-img {
      height: 36px;
    }
    
    .hero__title-block {
      top: 80px;
      left: 20px;
    }
    
    /* На мобильных CTA выходит за пределы image-wrap */
    .hero__cutout--bottom-left {
      display: none;
    }
    
    .hero__cta-btn {
      position: absolute;
      bottom: var(--hero-padding);
      left: var(--hero-padding);
      right: var(--hero-padding);
      width: auto;
      /* Liquid glass style for mobile */
      background: linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.25) 0%,
        rgba(255, 255, 255, 0.15) 50%,
        rgba(255, 255, 255, 0.2) 100%
      );
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      border: 1px solid rgba(255, 255, 255, 0.3);
      box-shadow: 
        0 8px 32px rgba(0, 0, 0, 0.1),
        inset 0 1px 0 rgba(255, 255, 255, 0.3);
    }
    
    .hero__cta-btn .hero__btn-text--dark {
      color: black;
    }
    
    .hero__cta-btn .hero__btn-icon--dark {
      background: rgba(0, 0, 0, 0.08);
      color: black;
    }
    
    /* Перемещаем CTA из image-wrap в hero */
    .hero__image-wrap .hero__cta-btn {
      position: fixed;
      bottom: 20px;
      left: 20px;
      right: 20px;
      z-index: 100;
    }
    
    .hero__right-block {
      position: absolute;
      bottom: 100px;
      left: 20px;
      right: 20px;
      top: auto;
      flex-direction: column;
    }
    
    .hero__menu-btn {
      top: var(--btn-gap);
      bottom: auto;
      right: var(--btn-gap);
    }
    
    .hero__mobile-menu {
      top: calc(var(--btn-gap) + 50px);
      bottom: auto;
    }
    
    .hero__btn-text {
      font-size: 22px;
    }
  }

  /* ================================================ */
  /* RESPONSIVE: MOBILE SMALL <480px                  */
  /* ================================================ */
  @media (max-width: 479px) {
    .hero {
      --hero-padding: 18px;
      --feedback-width: 0px;
      --feedback-height: 0px;
    }
    
    .hero__image-wrap {
      min-height: 400px;
    }
    
    .hero__title {
      font-size: 36px;
    }
    
    .hero__title-block {
      top: 60px;
      left: 16px;
    }
    
    .hero__logo-img {
      height: 30px;
    }
    
    /* Скрываем feedback на маленьких экранах */
    .hero__cutout--top-right,
    .hero__feedback-btn {
      display: none;
    }
    
    .hero__right-block {
      bottom: 80px;
    }
    
    .hero__description,
    .hero__learn-btn {
      padding: 16px;
    }
    
    .hero__description p {
      font-size: 14px;
    }
    
    .hero__btn-text {
      font-size: 20px;
    }
  }
</style>

<script>
  // Mobile menu toggle functionality
  document.addEventListener('DOMContentLoaded', () => {
    const menuToggle = document.getElementById('menuToggle');
    const mobileMenu = document.getElementById('mobileMenu');
    
    if (menuToggle && mobileMenu) {
      // Toggle menu on button click
      menuToggle.addEventListener('click', () => {
        menuToggle.classList.toggle('active');
        mobileMenu.classList.toggle('active');
      });
      
      // Close menu when clicking on a link
      const menuLinks = mobileMenu.querySelectorAll('.hero__mobile-menu-link');
      menuLinks.forEach(link => {
        link.addEventListener('click', () => {
          menuToggle.classList.remove('active');
          mobileMenu.classList.remove('active');
        });
      });
      
      // Close menu when clicking outside
      document.addEventListener('click', (e) => {
        const target = e.target as Node;
        if (!menuToggle.contains(target) && !mobileMenu.contains(target)) {
          menuToggle.classList.remove('active');
          mobileMenu.classList.remove('active');
        }
      });
    }
  });
</script>
