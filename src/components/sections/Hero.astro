---
/**
 * Hero Section — Bento-style layout
 * Дизайн с 3D изображением и обтекаемыми вырезами (все углы скруглены)
 */

const navItems = [
  { label: 'О центре', href: '#about' },
  { label: 'Услуги', href: '#services' },
  { label: 'Отзывы', href: '#reviews' },
  { label: 'Эксперты', href: '#experts' },
  { label: 'Цены', href: '#courses' },
  { label: 'Частые вопросы', href: '#faq' },
  { label: 'Контакты', href: '#contact' },
]
---

<section class="hero">
  <!-- Background Image with Mask -->
  <div class="hero__image-mask">
    <img 
      src="/images/hero/image 35261.png" 
      alt="3D логотип ЦЕРГ" 
      class="hero__image"
      loading="eager"
      fetchpriority="high"
    />
    <!-- Cutout for feedback button (top-right) -->
    <div class="hero__cutout hero__cutout--feedback"></div>
  </div>

  <!-- Title + Logo (top-left) -->
  <div class="hero__title-block">
    <div class="hero__title-row">
      <h1 class="hero__title">Центр</h1>
      <div class="hero__logo">
        <img src="/images/logo.png" alt="ЦЕРГ" class="hero__logo-img" />
      </div>
    </div>
    <h1 class="hero__title">регрессивного</h1>
    <h1 class="hero__title">гипноза</h1>
  </div>

  <!-- Feedback Button (top-right, in cutout) -->
  <a href="#contact" class="hero__feedback-btn">
    Связаться с нами
  </a>

  <!-- Description (right side, middle) - Liquid Glass -->
  <div class="hero__description">
    <p>
      Помогаем адаптировать психические и физические реакции к негативным раздражителям 
      в повседневной жизни, что приводит к внутреннему равновесию и здоровому пофигизму
    </p>
  </div>

  <!-- Learn More Button (right side, below description) - Liquid Glass -->
  <a href="#training" class="hero__learn-btn">
    <span class="hero__btn-text">
      Узнать<br />об обучении
    </span>
    <div class="hero__btn-icon">
      <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
        <path d="M1 12L12 1M12 1H3M12 1V10" stroke="currentColor" stroke-width="2"/>
      </svg>
    </div>
  </a>

  <!-- CTA Button (bottom-left) -->
  <a href="#contact" class="hero__cta-btn">
    <span class="hero__btn-text hero__btn-text--dark">
      Записаться<br />на консультацию
    </span>
    <div class="hero__btn-icon hero__btn-icon--dark">
      <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
        <path d="M1 12L12 1M12 1H3M12 1V10" stroke="currentColor" stroke-width="2"/>
      </svg>
    </div>
  </a>

  <!-- Navigation Pills (bottom-center) -->
  <nav class="hero__nav">
    {navItems.map((item) => (
      <a href={item.href} class="hero__nav-link">{item.label}</a>
    ))}
  </nav>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    background: #2A2624;
    overflow: hidden;
    padding: 50px;
  }

  /* Background Image with Mask */
  .hero__image-mask {
    position: absolute;
    top: 50px;
    left: 50px;
    right: 50px;
    bottom: 70px;
    border-radius: 32px;
    overflow: hidden;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Cutout for feedback button - все углы скруглены */
  .hero__cutout {
    position: absolute;
    background: #2A2624;
  }

  .hero__cutout--feedback {
    top: 0;
    right: 0;
    width: 240px;
    height: 70px;
    border-bottom-left-radius: 32px;
  }

  /* Title Block */
  .hero__title-block {
    position: absolute;
    top: 80px;
    left: 80px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    z-index: 2;
  }

  .hero__title-row {
    display: flex;
    align-items: center;
    gap: 23px;
  }

  .hero__title {
    font-family: 'Roboto Flex', sans-serif;
    font-size: 65px;
    font-weight: 700;
    font-variation-settings: 'wdth' 65;
    line-height: 0.85;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: white;
    margin: 0;
  }

  .hero__logo {
    display: flex;
    align-items: center;
  }

  .hero__logo-img {
    height: 49px;
    width: auto;
  }

  /* Feedback Button (top-right, in cutout area) */
  .hero__feedback-btn {
    position: absolute;
    top: 50px;
    right: 50px;
    padding: 15px 34px;
    background: transparent;
    border: 1px solid white;
    border-radius: 999px;
    color: white;
    font-size: 16px;
    font-weight: 400;
    text-decoration: none;
    transition: all 0.2s ease;
    z-index: 2;
  }

  .hero__feedback-btn:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  /* Description Block - Liquid Glass */
  .hero__description {
    position: absolute;
    top: 260px;
    right: 80px;
    width: 280px;
    padding: 20px;
    /* Liquid Glass Effect */
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.15) 0%,
      rgba(255, 255, 255, 0.05) 50%,
      rgba(255, 255, 255, 0.1) 100%
    );
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: 
      0 8px 32px rgba(0, 0, 0, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
    border-radius: 24px;
    z-index: 2;
  }

  .hero__description p {
    color: white;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.3;
    margin: 0;
  }

  /* Learn More Button - Liquid Glass */
  .hero__learn-btn {
    position: absolute;
    bottom: 200px;
    right: 80px;
    width: 280px;
    padding: 20px;
    /* Liquid Glass Effect */
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.15) 0%,
      rgba(255, 255, 255, 0.05) 50%,
      rgba(255, 255, 255, 0.1) 100%
    );
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: 
      0 8px 32px rgba(0, 0, 0, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
    border-radius: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-decoration: none;
    z-index: 2;
    transition: all 0.2s ease;
  }

  .hero__learn-btn:hover {
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.2) 0%,
      rgba(255, 255, 255, 0.08) 50%,
      rgba(255, 255, 255, 0.12) 100%
    );
  }

  /* CTA Button */
  .hero__cta-btn {
    position: absolute;
    bottom: 70px;
    left: 50px;
    width: 391px;
    height: 79px;
    padding: 16px 20px;
    background: white;
    border-radius: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-decoration: none;
    z-index: 2;
    transition: all 0.2s ease;
  }

  .hero__cta-btn:hover {
    background: #f5f5f5;
  }

  /* Button Text */
  .hero__btn-text {
    font-family: 'Roboto Flex', sans-serif;
    font-size: 28px;
    font-weight: 800;
    font-variation-settings: 'wdth' 25;
    line-height: 0.86;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: white;
  }

  .hero__btn-text--dark {
    color: black;
  }

  /* Button Icon */
  .hero__btn-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    color: white;
    align-self: flex-end;
  }

  .hero__btn-icon--dark {
    width: 48px;
    height: 48px;
    background: rgba(0, 0, 0, 0.08);
    color: black;
  }

  /* Navigation Pills */
  .hero__nav {
    position: absolute;
    bottom: 78px;
    left: 480px;
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 2;
  }

  .hero__nav-link {
    padding: 10px 18px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 999px;
    color: white;
    font-size: 16px;
    font-weight: 400;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .hero__nav-link:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: white;
  }

  /* ===================== */
  /* Responsive Styles     */
  /* ===================== */

  /* Large Desktop */
  @media (max-width: 1400px) {
    .hero__nav {
      left: 420px;
    }
  }

  /* Tablet */
  @media (max-width: 1200px) {
    .hero {
      padding: 30px;
    }

    .hero__image-mask {
      left: 30px;
      right: 30px;
      top: 30px;
      bottom: 50px;
    }

    .hero__title-block {
      left: 50px;
      top: 60px;
    }

    .hero__title {
      font-size: 48px;
    }

    .hero__feedback-btn {
      right: 30px;
      top: 30px;
    }

    .hero__cutout--feedback {
      width: 220px;
      height: 60px;
    }

    .hero__description {
      right: 50px;
      top: 220px;
      width: 240px;
      padding: 16px;
    }

    .hero__description p {
      font-size: 16px;
    }

    .hero__learn-btn {
      right: 50px;
      bottom: 160px;
      width: 240px;
      padding: 16px;
    }

    .hero__cta-btn {
      left: 30px;
      bottom: 50px;
      width: 320px;
    }

    .hero__btn-text {
      font-size: 22px;
    }

    .hero__nav {
      left: 370px;
      bottom: 60px;
    }

    .hero__nav-link {
      padding: 8px 14px;
      font-size: 14px;
    }
  }

  /* Small Tablet */
  @media (max-width: 1024px) {
    .hero__nav {
      left: 50%;
      transform: translateX(-50%);
      flex-wrap: wrap;
      justify-content: center;
      max-width: 500px;
    }

    .hero__cta-btn {
      width: 280px;
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .hero__image-mask {
      position: relative;
      top: 0;
      left: 0;
      right: 0;
      bottom: auto;
      height: 350px;
      border-radius: 24px;
      order: 2;
    }

    .hero__cutout {
      display: none;
    }

    .hero__title-block {
      position: relative;
      top: 0;
      left: 0;
      order: 1;
      margin-bottom: 10px;
    }

    .hero__title {
      font-size: clamp(32px, 10vw, 48px);
    }

    .hero__logo-img {
      height: 36px;
    }

    .hero__feedback-btn {
      display: none;
    }

    .hero__description {
      position: relative;
      top: 0;
      right: 0;
      width: 100%;
      order: 3;
    }

    .hero__learn-btn {
      position: relative;
      top: 0;
      right: 0;
      bottom: auto;
      width: 100%;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      order: 5;
    }

    .hero__cta-btn {
      position: relative;
      bottom: 0;
      left: 0;
      width: 100%;
      height: auto;
      order: 4;
    }

    .hero__nav {
      position: relative;
      bottom: 0;
      left: 0;
      transform: none;
      max-width: none;
      overflow-x: auto;
      justify-content: flex-start;
      flex-wrap: nowrap;
      padding-bottom: 10px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      order: 6;
    }

    .hero__nav::-webkit-scrollbar {
      display: none;
    }
  }
</style>
