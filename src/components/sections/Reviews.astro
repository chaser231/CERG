---
/**
 * Reviews Section
 * Отзывы клиентов (анонимные, текстовые) и учеников (с фото) с табами и слайдером
 * Данные загружаются из CMS (src/content/reviews/)
 */
import { getCollection } from 'astro:content';

// Загружаем отзывы из CMS
const reviewsCollection = await getCollection('reviews');

// Отзывы клиентов — анонимные, текстовые карточки
const clientReviews = reviewsCollection
  .filter(r => r.data.category === 'clients')
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map((r, index) => ({
    id: `client-review-${index}`,
    text: r.data.quote,
    fullText: r.data.fullText || r.data.quote, // Полный текст или краткая цитата
    hasFullText: !!r.data.fullText && r.data.fullText !== r.data.quote,
  }));

// Отзывы учеников — с фото и именем
const studentReviews = reviewsCollection
  .filter(r => r.data.category === 'students')
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map(r => ({
    name: r.data.name || 'Ученик',
    role: r.data.role || '',
    text: r.data.quote,
    image: r.data.image || '/images/reviews/review-1.webp',
  }));
---

<section class="reviews" id="reviews">
  <div class="reviews__container">
    <!-- Left Column: Header + Tabs + VK Button -->
    <div class="reviews__left">
      <div class="reviews__header">
        <h2 class="reviews__title">Отзывы клиентов и учеников</h2>
        <p class="reviews__description">
          Узнайте, что говорят о нас наши клиенты и ученики после прохождения наших курсов и сеансов
        </p>
      </div>

      <!-- Tabs -->
      <div class="reviews__tabs">
        <button class="reviews__tab reviews__tab--active" data-tab="clients">
          Клиенты
        </button>
        <button class="reviews__tab" data-tab="students">
          <img src="/images/reviews/review-3.webp" alt="" class="reviews__tab-avatar" />
          <img src="/images/reviews/review-1.webp" alt="" class="reviews__tab-avatar" />
          Ученики
        </button>
      </div>

      <!-- VK Button -->
      <a href="https://vk.com/cerghypno" target="_blank" rel="noopener noreferrer" class="reviews__vk-btn">
        Больше отзывов в нашей группе ВКонтакте
      </a>

      <!-- Navigation - привязан к левому блоку -->
      <div class="reviews__nav">
        <button class="reviews__nav-btn reviews__nav-btn--prev" aria-label="Предыдущий отзыв">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15,18 9,12 15,6"></polyline>
          </svg>
        </button>
        <button class="reviews__nav-btn reviews__nav-btn--next" aria-label="Следующий отзыв">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9,18 15,12 9,6"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <!-- Right Column: Cards Slider -->
    <div class="reviews__slider">
      <!-- Clients Reviews — анонимные текстовые карточки -->
      <div class="reviews__track reviews__track--clients">
        {clientReviews.map((review) => (
          <article class="review-card review-card--text">
            <div class="review-card__quote-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" opacity="0.15">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
              </svg>
            </div>
            <p class="review-card__text-content">{review.text}</p>
            {review.hasFullText && (
              <button 
                class="review-card__read-more" 
                data-review-id={review.id}
                data-full-text={review.fullText}
              >
                Читать весь отзыв
              </button>
            )}
          </article>
        ))}
      </div>
      
      <!-- Students Reviews — с фото (hidden by default) -->
      <div class="reviews__track reviews__track--students" style="display: none;">
        {studentReviews.map((review) => (
          <article class="review-card review-card--photo">
            <img 
              src={review.image} 
              alt={review.name}
              class="review-card__image"
              loading="lazy"
            />
            <!-- Имя и роль сверху -->
            <div class="review-card__header">
              <h4 class="review-card__name">{review.name}</h4>
              {review.role && <span class="review-card__role">{review.role}</span>}
            </div>
            <!-- Цитата снизу -->
            <div class="review-card__footer">
              <p class="review-card__text">{review.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- Modal for full review text -->
<div class="review-modal" id="reviewModal">
  <div class="review-modal__backdrop"></div>
  <div class="review-modal__content">
    <button class="review-modal__close" aria-label="Закрыть">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <div class="review-modal__quote-icon">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor" opacity="0.1">
        <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
      </svg>
    </div>
    <p class="review-modal__text" id="reviewModalText"></p>
  </div>
</div>

<script>
  // Tab switching
  const tabs = document.querySelectorAll('.reviews__tab');
  const clientsTrack = document.querySelector('.reviews__track--clients') as HTMLElement | null;
  const studentsTrack = document.querySelector('.reviews__track--students') as HTMLElement | null;

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      // Update active tab
      tabs.forEach(t => t.classList.remove('reviews__tab--active'));
      tab.classList.add('reviews__tab--active');
      
      // Show/hide tracks
      const tabType = (tab as HTMLElement).dataset.tab;
      if (tabType === 'clients') {
        if (clientsTrack) clientsTrack.style.display = 'flex';
        if (studentsTrack) studentsTrack.style.display = 'none';
      } else {
        if (clientsTrack) clientsTrack.style.display = 'none';
        if (studentsTrack) studentsTrack.style.display = 'flex';
      }
    });
  });

  // Slider navigation
  const prevBtn = document.querySelector('.reviews__nav-btn--prev');
  const nextBtn = document.querySelector('.reviews__nav-btn--next');
  
  function getActiveTrack(): HTMLElement | null {
    if (clientsTrack && clientsTrack.style.display !== 'none') return clientsTrack;
    return studentsTrack || clientsTrack;
  }
  
  const cardWidth = 320 + 16; // card width + gap
  
  prevBtn?.addEventListener('click', () => {
    getActiveTrack()?.scrollBy({ left: -cardWidth, behavior: 'smooth' });
  });
  
  nextBtn?.addEventListener('click', () => {
    getActiveTrack()?.scrollBy({ left: cardWidth, behavior: 'smooth' });
  });

  // Modal functionality
  const modal = document.getElementById('reviewModal');
  const modalText = document.getElementById('reviewModalText');
  const modalBackdrop = document.querySelector('.review-modal__backdrop');
  const modalClose = document.querySelector('.review-modal__close');
  const readMoreButtons = document.querySelectorAll('.review-card__read-more');

  function openModal(text: string) {
    if (modal && modalText) {
      modalText.textContent = text;
      modal.classList.add('review-modal--open');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.remove('review-modal--open');
      document.body.style.overflow = '';
    }
  }

  readMoreButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const fullText = (btn as HTMLElement).dataset.fullText;
      if (fullText) openModal(fullText);
    });
  });

  modalBackdrop?.addEventListener('click', closeModal);
  modalClose?.addEventListener('click', closeModal);
  
  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>

<style>
  .reviews {
    background: white;
    border-radius: 32px;
    margin: 20px;
    padding: 24px;
    /* Убираем padding справа — слайдер будет до края */
    padding-right: 0;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .reviews {
      padding: 33px;
      padding-right: 0;
    }
  }

  .reviews__container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 1024px) {
    .reviews__container {
      flex-direction: row;
      gap: 2rem;
    }
  }

  /* Left Column */
  .reviews__left {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    flex-shrink: 0;
  }

  @media (min-width: 1024px) {
    .reviews__left {
      width: 480px;
      justify-content: space-between;
    }
  }

  .reviews__header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .reviews__title {
    color: var(--color-text);
    font-size: clamp(36px, 5vw, 65px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0;
  }

  .reviews__description {
    color: var(--color-text);
    font-size: 1.125rem;
    line-height: 1.17;
    max-width: 400px;
    margin: 0;
  }

  @media (min-width: 768px) {
    .reviews__description {
      font-size: 1.25rem;
    }
  }

  /* Tabs */
  .reviews__tabs {
    display: flex;
    gap: 1rem;
  }

  .reviews__tab {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-muted);
    transition: all 0.2s ease;
    border-radius: 999px;
  }

  .reviews__tab:hover {
    color: var(--color-text);
  }

  .reviews__tab--active {
    background: var(--color-beige-200);
    color: var(--color-text);
  }

  .reviews__tab-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    margin-left: -12px;
    border: 2px solid white;
  }

  .reviews__tab-avatar:first-of-type {
    margin-left: 0;
  }

  /* VK Button - outline only */
  .reviews__vk-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 20px 32px;
    background: transparent;
    border: 1px solid var(--color-dark);
    color: var(--color-dark);
    font-size: 16px;
    font-weight: 400;
    text-decoration: none;
    border-radius: 999px;
    transition: all 0.2s ease;
    width: fit-content;
  }

  .reviews__vk-btn:hover {
    background: var(--color-dark);
    color: white;
  }

  /* Navigation */
  .reviews__nav {
    display: flex;
    gap: 0.5rem;
  }

  .reviews__nav-btn {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #F2F2F2;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-dark);
    transition: all 0.2s ease;
  }

  .reviews__nav-btn:hover {
    background: var(--color-beige-200);
  }

  .reviews__nav-btn:active {
    transform: scale(0.95);
  }

  /* Right Column: Slider */
  /* Right Column: Slider - карточки идут до правого края белого блока */
  .reviews__slider {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    /* Вытягиваем слайдер за пределы padding контейнера */
    margin-right: -24px;
  }

  @media (min-width: 768px) {
    .reviews__slider {
      margin-right: -33px;
    }
  }

  @media (min-width: 1024px) {
    .reviews__slider {
      margin-right: 0;
    }
  }

  .reviews__track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
  }

  .reviews__track::-webkit-scrollbar {
    display: none;
  }

  /* ===== Review Card with Photo (Students) ===== */
  .review-card--photo {
    flex: 0 0 280px;
    scroll-snap-align: start;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    min-height: 450px;
  }

  @media (min-width: 640px) {
    .review-card--photo {
      flex: 0 0 320px;
      min-height: 500px;
    }
  }

  /* Фото заполняет всю карточку */
  .review-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    z-index: 0;
  }

  /* Имя и роль сверху */
  .review-card__header {
    position: relative;
    z-index: 1;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.6) 0%,
      rgba(0, 0, 0, 0.3) 60%,
      transparent 100%
    );
  }

  .review-card__name {
    color: white;
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0;
  }

  .review-card__role {
    color: rgba(255, 255, 255, 0.7);
    font-size: 12px;
    font-weight: 300;
    line-height: 1.17;
  }

  /* Цитата снизу */
  .review-card__footer {
    position: relative;
    z-index: 1;
    padding: 16px;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.8) 0%,
      rgba(0, 0, 0, 0.4) 60%,
      transparent 100%
    );
  }

  .review-card__text {
    color: white;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.3;
    margin: 0;
  }

  /* ===== Review Card Text Only (Clients - Anonymous) ===== */
  .review-card--text {
    flex: 0 0 280px;
    scroll-snap-align: start;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 24px;
    background: var(--color-beige-200);
    min-height: 280px;
    position: relative;
  }

  @media (min-width: 640px) {
    .review-card--text {
      flex: 0 0 320px;
      min-height: 300px;
      padding: 28px;
    }
  }

  .review-card__quote-icon {
    color: var(--color-dark);
    margin-bottom: 16px;
  }

  .review-card__text-content {
    color: var(--color-text);
    font-size: 15px;
    line-height: 1.5;
    margin: 0;
    flex: 1;
    /* Ограничиваем текст с ellipsis */
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .review-card__text-content {
      font-size: 16px;
      -webkit-line-clamp: 7;
    }
  }

  .review-card__read-more {
    margin-top: 16px;
    padding: 12px 20px;
    background: white;
    border: none;
    border-radius: 999px;
    color: var(--color-text);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    align-self: flex-start;
  }

  .review-card__read-more:hover {
    background: var(--color-dark);
    color: white;
  }

  /* ===== Modal ===== */
  .review-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .review-modal--open {
    opacity: 1;
    visibility: visible;
  }

  .review-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
  }

  .review-modal__content {
    position: relative;
    background: white;
    border-radius: 24px;
    padding: 32px;
    max-width: 600px;
    width: 100%;
    max-height: 80vh;
    overflow-y: auto;
    transform: translateY(20px);
    transition: transform 0.3s ease;
  }

  .review-modal--open .review-modal__content {
    transform: translateY(0);
  }

  @media (min-width: 640px) {
    .review-modal__content {
      padding: 40px;
    }
  }

  .review-modal__close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-beige-200);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-dark);
    transition: all 0.2s ease;
  }

  .review-modal__close:hover {
    background: var(--color-dark);
    color: white;
  }

  .review-modal__quote-icon {
    color: var(--color-dark);
    margin-bottom: 16px;
  }

  .review-modal__text {
    color: var(--color-text);
    font-size: 16px;
    line-height: 1.6;
    margin: 0;
    white-space: pre-wrap;
  }

  @media (min-width: 640px) {
    .review-modal__text {
      font-size: 18px;
    }
  }
</style>
