const studentReviews = [
  {
    name: 'Анна К.',
    role: 'Выпускница курса',
    text: 'Курс превзошёл все мои ожидания! Теперь я уверенно применяю техники гипноза в своей практике.',
    image: '/images/reviews/review-2.png',
  },
  {
    name: 'Дмитрий В.',
    role: 'Выпускник',
    text: 'Благодаря обучению в ЦЕРГ я получил новую профессию и начал помогать людям.',
    image: '/images/reviews/review-1.png',
  },
  {
    name: 'Светлана П.',
    role: 'Психолог',
    text: 'Прошла курс регрессивного гипноза. Теперь это основной инструмент в моей работе с клиентами.',
    image: '/images/reviews/review-3.png',
  },
  {
    name: 'Максим Т.',
    role: 'Начинающий гипнолог',
    text: 'Структурированная программа и отличные преподаватели. Получил все необходимые навыки для старта.',
    image: '/images/reviews/review-1.png',
  },
  {
    name: 'Ирина Б.',
    role: 'Психотерапевт',
    text: 'Курс по ДПДГ открыл новые возможности в терапии травм. Клиенты отмечают быстрые результаты.',
    image: '/images/reviews/review-2.png',
  },
  {
    name: 'Алексей Н.',
    role: 'Коуч',
    text: 'Разговорный гипноз — мощный инструмент! Теперь мои консультации стали эффективнее в разы.',
    image: '/images/reviews/review-3.png',
  },
  {
    name: 'Виктория Л.',
    role: 'Выпускница',
    text: 'Обучение самогипнозу изменило мою жизнь. Научилась управлять стрессом и эмоциями.',
    image: '/images/reviews/review-1.png',
  },
  {
    name: 'Роман Д.',
    role: 'Врач',
    text: 'Сертификат ЦЕРГ признаётся в профессиональном сообществе. Горжусь своим обучением!',
    image: '/images/reviews/review-2.png',
  },
