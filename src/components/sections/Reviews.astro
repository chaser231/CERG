---

<section class="reviews" id="reviews">
  <div class="reviews__container">
    <!-- Left Column: Header + Tabs + VK Button -->
    <div class="reviews__left">
      <div class="reviews__header">
        <h2 class="reviews__title">Отзывы клиентов и учеников</h2>
        <p class="reviews__description">
          Узнайте, что говорят о нас наши клиенты и ученики после прохождения наших курсов и сеансов
        </p>
      </div>

      <!-- Tabs -->
      <div class="reviews__tabs">
        <button class="reviews__tab reviews__tab--active" data-tab="clients">
          <img src="/images/reviews/review-1.png" alt="" class="reviews__tab-avatar" />
          <img src="/images/reviews/review-2.png" alt="" class="reviews__tab-avatar" />
          Клиенты
        </button>
        <button class="reviews__tab" data-tab="students">
          <img src="/images/reviews/review-3.png" alt="" class="reviews__tab-avatar" />
          <img src="/images/reviews/review-1.png" alt="" class="reviews__tab-avatar" />
          Ученики
        </button>
      </div>

      <!-- VK Button -->
      <a href="https://vk.com/cerghypno" target="_blank" rel="noopener noreferrer" class="reviews__vk-btn">
        Больше отзывов в нашей группе ВКонтакте
      </a>

      <!-- Navigation - привязан к левому блоку -->
      <div class="reviews__nav">
        <button class="reviews__nav-btn reviews__nav-btn--prev" aria-label="Предыдущий отзыв">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15,18 9,12 15,6"></polyline>
          </svg>
        </button>
        <button class="reviews__nav-btn reviews__nav-btn--next" aria-label="Следующий отзыв">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9,18 15,12 9,6"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <!-- Right Column: Cards Slider -->
    <div class="reviews__slider">
      <!-- Clients Reviews -->
      <div class="reviews__track reviews__track--clients">
        {clientReviews.map((review) => (
          <article class="review-card">
            <img 
              src={review.image} 
              alt={review.name}
              class="review-card__image"
              loading="lazy"
            />
            <!-- Имя и роль сверху -->
            <div class="review-card__header">
              <h4 class="review-card__name">{review.name}</h4>
              <span class="review-card__role">{review.role}</span>
            </div>
            <!-- Цитата снизу -->
            <div class="review-card__footer">
              <p class="review-card__text">{review.text}</p>
            </div>
          </article>
        ))}
      </div>
      
      <!-- Students Reviews (hidden by default) -->
      <div class="reviews__track reviews__track--students" style="display: none;">
        {studentReviews.map((review) => (
          <article class="review-card">
            <img 
              src={review.image} 
              alt={review.name}
              class="review-card__image"
              loading="lazy"
            />
            <!-- Имя и роль сверху -->
            <div class="review-card__header">
              <h4 class="review-card__name">{review.name}</h4>
              <span class="review-card__role">{review.role}</span>
            </div>
            <!-- Цитата снизу -->
            <div class="review-card__footer">
              <p class="review-card__text">{review.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // Tab switching
  const tabs = document.querySelectorAll('.reviews__tab');
  const clientsTrack = document.querySelector('.reviews__track--clients');
  const studentsTrack = document.querySelector('.reviews__track--students');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      // Update active tab
      tabs.forEach(t => t.classList.remove('reviews__tab--active'));
      tab.classList.add('reviews__tab--active');
      
      // Show/hide tracks
      const tabType = tab.dataset.tab;
      if (tabType === 'clients') {
        clientsTrack.style.display = 'flex';
        studentsTrack.style.display = 'none';
      } else {
        clientsTrack.style.display = 'none';
        studentsTrack.style.display = 'flex';
      }
    });
  });

  // Slider navigation
  const prevBtn = document.querySelector('.reviews__nav-btn--prev');
  const nextBtn = document.querySelector('.reviews__nav-btn--next');
  
  function getActiveTrack() {
    return clientsTrack.style.display !== 'none' ? clientsTrack : studentsTrack;
  }
  
  const cardWidth = 320 + 16; // card width + gap
  
  prevBtn?.addEventListener('click', () => {
    getActiveTrack().scrollBy({ left: -cardWidth, behavior: 'smooth' });
  });
  
  nextBtn?.addEventListener('click', () => {
    getActiveTrack().scrollBy({ left: cardWidth, behavior: 'smooth' });
  });
</script>

<style>
  .reviews {
    background: white;
    border-radius: 32px;
    margin: 20px;
    padding: 24px;
    /* Убираем padding справа — слайдер будет до края */
    padding-right: 0;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .reviews {
      padding: 33px;
      padding-right: 0;
    }
  }

  .reviews__container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 1024px) {
    .reviews__container {
      flex-direction: row;
      gap: 2rem;
    }
  }

  /* Left Column */
  .reviews__left {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    flex-shrink: 0;
  }

  @media (min-width: 1024px) {
    .reviews__left {
      width: 480px;
      justify-content: space-between;
    }
  }

  .reviews__header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .reviews__title {
    color: var(--color-text);
    font-size: clamp(36px, 5vw, 65px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0;
  }

  .reviews__description {
    color: var(--color-text);
    font-size: 1.125rem;
    line-height: 1.17;
    max-width: 400px;
    margin: 0;
  }

  @media (min-width: 768px) {
    .reviews__description {
      font-size: 1.25rem;
    }
  }

  /* Tabs */
  .reviews__tabs {
    display: flex;
    gap: 1rem;
  }

  .reviews__tab {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-muted);
    transition: all 0.2s ease;
    border-radius: 999px;
  }

  .reviews__tab:hover {
    color: var(--color-text);
  }

  .reviews__tab--active {
    background: var(--color-beige-200);
    color: var(--color-text);
  }

  .reviews__tab-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    margin-left: -12px;
    border: 2px solid white;
  }

  .reviews__tab-avatar:first-of-type {
    margin-left: 0;
  }

  /* VK Button - outline only */
  .reviews__vk-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 20px 32px;
    background: transparent;
    border: 1px solid var(--color-dark);
    color: var(--color-dark);
    font-size: 16px;
    font-weight: 400;
    text-decoration: none;
    border-radius: 999px;
    transition: all 0.2s ease;
    width: fit-content;
  }

  .reviews__vk-btn:hover {
    background: var(--color-dark);
    color: white;
  }

  /* Navigation */
  .reviews__nav {
    display: flex;
    gap: 0.5rem;
  }

  .reviews__nav-btn {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #F2F2F2;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-dark);
    transition: all 0.2s ease;
  }

  .reviews__nav-btn:hover {
    background: var(--color-beige-200);
  }

  .reviews__nav-btn:active {
    transform: scale(0.95);
  }

  /* Right Column: Slider */
  /* Right Column: Slider - карточки идут до правого края белого блока */
  .reviews__slider {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    /* Вытягиваем слайдер за пределы padding контейнера */
    margin-right: -24px;
  }

  @media (min-width: 768px) {
    .reviews__slider {
      margin-right: -33px;
    }
  }

  @media (min-width: 1024px) {
    .reviews__slider {
      margin-right: 0;
    }
  }

  .reviews__track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
  }

  .reviews__track::-webkit-scrollbar {
    display: none;
  }

  /* Review Card - фото на весь фон */
  .review-card {
    flex: 0 0 280px;
    scroll-snap-align: start;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    min-height: 450px;
  }

  @media (min-width: 640px) {
    .review-card {
      flex: 0 0 320px;
      min-height: 500px;
    }
  }

  /* Фото заполняет всю карточку */
  .review-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    z-index: 0;
  }

  /* Имя и роль сверху */
  .review-card__header {
    position: relative;
    z-index: 1;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.6) 0%,
      rgba(0, 0, 0, 0.3) 60%,
      transparent 100%
    );
  }

  .review-card__name {
    color: white;
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0;
  }

  .review-card__role {
    color: rgba(255, 255, 255, 0.7);
    font-size: 12px;
    font-weight: 300;
    line-height: 1.17;
  }

  /* Цитата снизу */
  .review-card__footer {
    position: relative;
    z-index: 1;
    padding: 16px;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.8) 0%,
      rgba(0, 0, 0, 0.4) 60%,
      transparent 100%
    );
  }

  .review-card__text {
    color: white;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.3;
    margin: 0;
  }
</style>
