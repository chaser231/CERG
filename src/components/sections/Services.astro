---
/**
 * Services Section
 * Карточки услуг с изображениями, описанием, ценой и длительностью
 * Табы: Терапия / Пакеты
 * Данные загружаются из CMS (src/content/services/)
 */
import { getCollection } from 'astro:content';

// Загружаем услуги из CMS, фильтруем featured и сортируем по order
const servicesCollection = await getCollection('services');

// Функция для маппинга данных услуги
const mapService = (s: typeof servicesCollection[0]) => ({
  title: s.data.title,
  description: s.data.description,
  duration: s.data.duration > 0 ? `${s.data.duration} ${s.data.durationLabel}` : null,
  price: s.data.price > 0 ? `${s.data.price} ${s.data.priceLabel}` : 'Бесплатно',
  image: s.data.image,
});

// Разделяем на Терапию и Пакеты
const therapyServices = servicesCollection
  .filter(s => s.data.featured && (s.data.category === 'services' || !s.data.category))
  .sort((a, b) => a.data.order - b.data.order)
  .map(mapService);

const packageServices = servicesCollection
  .filter(s => s.data.featured && s.data.category === 'packages')
  .sort((a, b) => a.data.order - b.data.order)
  .map(mapService);

// Проверяем, есть ли данные в каждой категории
const hasTherapy = therapyServices.length > 0;
const hasPackages = packageServices.length > 0;
const showTabs = hasTherapy && hasPackages;
---

<section class="services" id="services">
  <div class="services__header container">
    <div class="services__header-left">
      <h2 class="services__title">Наши услуги</h2>
      
      {/* Tabs - показываем только если есть обе категории */}
      {showTabs && (
        <div class="services__tabs">
          <button class="services__tab services__tab--active" data-tab="therapy">
            Терапия
          </button>
          <button class="services__tab" data-tab="packages">
            Пакеты
          </button>
        </div>
      )}
    </div>
    
    <!-- Navigation Arrows -->
    <div class="services__nav">
      <button class="services__nav-btn services__nav-btn--prev" aria-label="Предыдущий слайд">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15,18 9,12 15,6"></polyline>
        </svg>
      </button>
      <button class="services__nav-btn services__nav-btn--next" aria-label="Следующий слайд">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9,18 15,12 9,6"></polyline>
        </svg>
      </button>
    </div>
  </div>

  <!-- Slider выходит за пределы контейнера -->
  <div class="services__slider">
    {/* Therapy Services Track */}
    <div class="services__track services__track--therapy">
      {therapyServices.map((service) => (
        <article class="service-card">
          <div class="service-card__image-wrap">
            <img 
              src={service.image} 
              alt={service.title}
              class="service-card__image"
              loading="lazy"
            />
            
            <!-- Badges -->
            <div class="service-card__badges">
              {service.price && (
                <span class="service-card__badge">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="service-card__badge-icon">
                    <path d="M19 5L5 19M5 5l14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <circle cx="5" cy="5" r="3" stroke="currentColor" stroke-width="1.5"/>
                    <circle cx="19" cy="19" r="3" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                  {service.price}
                </span>
              )}
              {service.duration && (
                <span class="service-card__badge">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="service-card__badge-icon">
                    <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M12 6v6l4 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                  {service.duration}
                </span>
              )}
            </div>
          </div>
          
          <div class="service-card__content">
            <h4 class="service-card__title">{service.title}</h4>
            <p class="service-card__description">{service.description}</p>
          </div>
        </article>
      ))}
    </div>

    {/* Packages Track - hidden by default */}
    {hasPackages && (
      <div class="services__track services__track--packages" style="display: none;">
        {packageServices.map((service) => (
          <article class="service-card">
            <div class="service-card__image-wrap">
              <img 
                src={service.image} 
                alt={service.title}
                class="service-card__image"
                loading="lazy"
              />
              
              <!-- Badges -->
              <div class="service-card__badges">
                {service.price && (
                  <span class="service-card__badge">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="service-card__badge-icon">
                      <path d="M19 5L5 19M5 5l14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                      <circle cx="5" cy="5" r="3" stroke="currentColor" stroke-width="1.5"/>
                      <circle cx="19" cy="19" r="3" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                    {service.price}
                  </span>
                )}
                {service.duration && (
                  <span class="service-card__badge">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="service-card__badge-icon">
                      <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M12 6v6l4 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                    {service.duration}
                  </span>
                )}
              </div>
            </div>
            
            <div class="service-card__content">
              <h4 class="service-card__title">{service.title}</h4>
              <p class="service-card__description">{service.description}</p>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</section>

<script>
  // Tab switching
  const tabs = document.querySelectorAll('.services__tab');
  const therapyTrack = document.querySelector('.services__track--therapy') as HTMLElement | null;
  const packagesTrack = document.querySelector('.services__track--packages') as HTMLElement | null;

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      // Update active tab
      tabs.forEach(t => t.classList.remove('services__tab--active'));
      tab.classList.add('services__tab--active');
      
      // Show/hide tracks
      const tabType = (tab as HTMLElement).dataset.tab;
      if (tabType === 'therapy') {
        if (therapyTrack) therapyTrack.style.display = 'flex';
        if (packagesTrack) packagesTrack.style.display = 'none';
      } else {
        if (therapyTrack) therapyTrack.style.display = 'none';
        if (packagesTrack) packagesTrack.style.display = 'flex';
      }
    });
  });

  // Slider navigation
  const prevBtn = document.querySelector('.services__nav-btn--prev');
  const nextBtn = document.querySelector('.services__nav-btn--next');
  
  function getActiveTrack(): HTMLElement | null {
    if (therapyTrack && therapyTrack.style.display !== 'none') return therapyTrack;
    return packagesTrack || therapyTrack;
  }
  
  const cardWidth = 489 + 10; // card width + gap
  
  prevBtn?.addEventListener('click', () => {
    const track = getActiveTrack();
    track?.scrollBy({ left: -cardWidth, behavior: 'smooth' });
  });
  
  nextBtn?.addEventListener('click', () => {
    const track = getActiveTrack();
    track?.scrollBy({ left: cardWidth, behavior: 'smooth' });
  });
</script>

<style>
  .services {
    background: white;
    padding-top: 50px;
    padding-bottom: 50px;
    overflow: hidden; /* Скрываем горизонтальный скролл на секции */
  }

  .services__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 768px) {
    .services__header {
      align-items: center;
      gap: 2rem;
    }
  }

  .services__header-left {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .services__header-left {
      flex-direction: row;
      align-items: center;
      gap: 2rem;
    }
  }

  .services__title {
    color: var(--color-dark-soft);
    font-size: clamp(40px, 5vw, 65px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0;
  }

  /* Tabs - лаконичный стиль */
  .services__tabs {
    display: flex;
    gap: 0.5rem;
    background: #F2F2F2;
    padding: 4px;
    border-radius: 999px;
  }

  .services__tab {
    padding: 10px 20px;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-muted);
    transition: all 0.2s ease;
    border-radius: 999px;
    white-space: nowrap;
  }

  @media (min-width: 640px) {
    .services__tab {
      padding: 12px 24px;
      font-size: 16px;
    }
  }

  .services__tab:hover {
    color: var(--color-text);
  }

  .services__tab--active {
    background: white;
    color: var(--color-text);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .services__nav {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .services__nav-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #F2F2F2;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-dark);
    transition: all 0.2s ease;
  }

  @media (min-width: 640px) {
    .services__nav-btn {
      width: 60px;
      height: 60px;
    }
  }

  .services__nav-btn:hover {
    background: var(--color-beige-200);
  }
  
  .services__nav-btn:active {
    transform: scale(0.95);
  }

  /* Slider wrapper - full width, overflow hidden */
  .services__slider {
    width: 100%;
    overflow: hidden;
  }

  /* Track - scrollable, выходит за пределы viewport */
  .services__track {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    /* Левый отступ для выравнивания с заголовком */
    padding-left: 20px;
    /* Правый padding для последней карточки */
    padding-right: 20px;
    scroll-behavior: smooth;
  }

  .services__track::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 768px) {
    .services__track {
      padding-left: 50px;
      padding-right: 50px;
    }
  }
  
  /* Для очень больших экранов центрируем контент */
  @media (min-width: 1540px) {
    .services__track {
      padding-left: calc((100vw - 1440px) / 2 + 50px);
    }
  }

  /* Service Card - фиксированные размеры как в Figma: 489×538px */
  .service-card {
    flex: 0 0 300px;
    scroll-snap-align: start;
    background: #DEDCD9;
    border-radius: 28px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    height: 450px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  @media (min-width: 480px) {
    .service-card {
      flex: 0 0 380px;
      height: 500px;
    }
  }

  @media (min-width: 768px) {
    .service-card {
      flex: 0 0 450px;
      height: 520px;
    }
  }

  @media (min-width: 1200px) {
    .service-card {
      flex: 0 0 489px;
      height: 538px;
    }
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
  }

  .service-card__image-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .service-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  /* Badges - Liquid Glass Effect */
  .service-card__badges {
    position: absolute;
    top: 20px;
    right: 16px;
    display: flex;
    flex-direction: row;
    gap: 8px;
    z-index: 2;
  }

  @media (min-width: 640px) {
    .service-card__badges {
      right: 20px;
    }
  }

  .service-card__badge {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px;
    /* Liquid Glass Effect */
    background: linear-gradient(
      135deg,
      rgba(117, 109, 94, 0.25) 0%,
      rgba(117, 109, 94, 0.15) 50%,
      rgba(117, 109, 94, 0.2) 100%
    );
    backdrop-filter: blur(75px) saturate(180%);
    -webkit-backdrop-filter: blur(75px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 
      0 4px 16px rgba(0, 0, 0, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    color: white;
    font-size: 16px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  @media (min-width: 640px) {
    .service-card__badge {
      font-size: 20px;
    }
  }

  .service-card__badge-icon {
    flex-shrink: 0;
  }

  /* Content block at bottom - симметричные скругления */
  .service-card__content {
    background: white;
    border-radius: 16px;
    padding: 12px;
    margin: auto 16px 16px;
    position: relative;
    z-index: 1;
  }

  .service-card__title {
    color: var(--color-text-secondary);
    font-size: clamp(20px, 2.5vw, 32px);
    font-weight: 800;
    line-height: 0.875;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0 0 10px;
  }

  .service-card__description {
    color: var(--color-text-secondary);
    font-size: 12px;
    line-height: 1.33;
    margin: 0;
  }
</style>

