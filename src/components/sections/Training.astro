---
/**
 * Training Section
 * Обучение гипнозу с преимуществами и списком курсов
 * Курсы загружаются из CMS (src/content/courses/)
 */
import { getCollection } from 'astro:content';

// Преимущества (статичные, не редактируются через CMS)
const advantages = [
  {
    title: 'Практическая направленность',
    image: '/images/training/advantage-practice.webp',
    color: '#D7C7AE',
  },
  {
    title: 'Выдача сертификата',
    image: '/images/training/advantage-certificate.webp',
    color: '#D4C0A7',
  },
  {
    title: 'Поддержка после курса',
    image: '/images/training/advantage-support.webp',
    color: '#D7C5AD',
  },
  {
    title: 'Доступная стоимость',
    image: '/images/training/advantage-price.webp',
    color: '#BAA586',
  },
]

// Загружаем курсы из CMS
const coursesCollection = await getCollection('courses');
const courses = coursesCollection
  .filter(c => c.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .map(c => ({
    name: c.data.title,
    price: `${c.data.price.toLocaleString('ru-RU')} ${c.data.priceLabel}`,
    description: c.data.description || '',
    lessons: String(c.data.lessonsCount),
    hours: String(c.data.hoursCount),
  }));
---

<section class="training" id="training">
  <!-- Header -->
  <div class="training__header container">
    <h2 class="training__title">Обучение гипнозу</h2>
    <p class="training__description">
      Программа подходит для психологов, психотерапевтов, консультантов, врачей, коучей 
      и всех, кто хочет глубже понимать внутренние механизмы человека. Обучение включает теорию, практику и сертификацию
    </p>
  </div>

  <!-- Advantages -->
  <div class="training__advantages container">
    <h4 class="training__advantages-title">Наши преимущества</h4>
    
    <div class="advantages-grid">
      {advantages.map((item) => (
        <div class="advantage-card" style={`background-color: ${item.color}`}>
          <p class="advantage-card__title">{item.title}</p>
          <img 
            src={item.image} 
            alt="" 
            class="advantage-card__image"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </div>

  <!-- CTA Button -->
  <div class="training__cta container">
    <a href="#contact" class="training__cta-btn">
      Оставить заявку на обучение
    </a>
  </div>

  <!-- Courses -->
  <div class="training__courses" id="courses">
    <div class="courses-container">
      <h4 class="courses__title">Наши курсы</h4>
      
      <div class="courses-list">
        {courses.map((course, index) => (
          <div class="course-item">
            <div class="course-item__row">
              <h3 class="course-item__name">{course.name}</h3>
              <div class="course-item__details">
                <div class="course-item__info">
                  <span class="course-item__price">{course.price}</span>
                  <p class="course-item__description">{course.description}</p>
                </div>
                <div class="course-item__badges">
                  <span class="course-item__badge">
                    <span class="course-item__badge-value">{course.lessons}</span>
                    <span class="course-item__badge-label">занятий</span>
                  </span>
                  <span class="course-item__badge">
                    <span class="course-item__badge-value">{course.hours}</span>
                    <span class="course-item__badge-label">часов</span>
                  </span>
                </div>
              </div>
            </div>
            {index < courses.length - 1 && <div class="course-item__divider"></div>}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .training {
    background: var(--color-bg);
    padding-top: 80px;
    padding-bottom: 0;
  }

  .training__header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 1024px) {
    .training__header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
      gap: 2rem;
    }
  }

  .training__title {
    color: var(--color-text);
    font-size: clamp(40px, 5vw, 65px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0;
  }

  .training__description {
    color: var(--color-text);
    font-size: 1.125rem;
    line-height: 1.17;
    max-width: 481px;
    margin: 0;
  }

  @media (min-width: 768px) {
    .training__description {
      font-size: 1.25rem;
    }
  }

  /* Advantages */
  .training__advantages {
    margin-bottom: 2rem;
  }

  .training__advantages-title {
    color: var(--color-text);
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 800;
    line-height: 0.875;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    text-align: center;
    margin: 0 0 1.5rem;
  }

  .advantages-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 9px;
  }

  @media (min-width: 768px) {
    .advantages-grid {
      /* Первая карточка шире: 475px, остальные 280px */
      grid-template-columns: 475fr 280fr 280fr 280fr;
    }
  }

  .advantage-card {
    position: relative;
    border-radius: 24px;
    padding: 20px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    /* Высота как в Figma: Hug = по содержимому, но минимум 270px */
    min-height: 200px;
  }

  @media (min-width: 768px) {
    .advantage-card {
      min-height: 270px;
    }
  }

  .advantage-card__title {
    color: white;
    font-size: clamp(18px, 2.5vw, 32px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    font-variation-settings: 'wdth' 25;
    margin: 0;
    max-width: 200px;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 768px) {
    .advantage-card__title {
      font-size: clamp(24px, 2.5vw, 38px);
      max-width: 220px;
    }
  }

  /* Картинка заполняет всю карточку */
  .advantage-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    border-radius: 24px;
  }

  /* CTA */
  .training__cta {
    display: flex;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .training__cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 24px 48px;
    background: var(--color-primary);
    color: white;
    font-size: 16px;
    font-weight: 400;
    text-decoration: none;
    border-radius: 999px;
    transition: background 0.2s ease;
  }

  .training__cta-btn:hover {
    background: var(--color-primary-hover);
  }

  /* Courses */
  .training__courses {
    background: #E6E4E0;
    padding: 65px 50px;
  }

  .courses-container {
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .courses__title {
    color: black;
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 800;
    line-height: 0.875;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    text-align: center;
    margin: 0 0 2rem;
  }

  .courses-list {
    display: flex;
    flex-direction: column;
  }

  .course-item {
    display: flex;
    flex-direction: column;
  }

  .course-item__row {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2rem 0;
  }

  @media (min-width: 1024px) {
    .course-item__row {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
      gap: 4rem;
    }
  }

  .course-item__name {
    color: #B6B3AB;
    font-size: clamp(48px, 8vw, 125px);
    font-weight: 600;
    line-height: 0.8;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin: 0;
    white-space: pre-line;
    flex-shrink: 0;
    min-width: 300px;
  }

  @media (min-width: 1024px) {
    .course-item__name {
      min-width: 500px;
    }
  }

  .course-item__details {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 507px;
  }

  .course-item__info {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .course-item__price {
    color: var(--color-primary);
    font-size: clamp(40px, 5vw, 65px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .course-item__description {
    color: black;
    font-size: 16px;
    line-height: 1.21;
    margin: 0;
  }

  .course-item__badges {
    display: flex;
    gap: 8px;
  }

  .course-item__badge {
    display: flex;
    justify-content: center;
    gap: 10px;
    padding: 12px;
    /* Liquid Glass Effect */
    background: linear-gradient(
      135deg,
      rgba(205, 205, 205, 0.3) 0%,
      rgba(205, 205, 205, 0.15) 50%,
      rgba(205, 205, 205, 0.25) 100%
    );
    backdrop-filter: blur(75px) saturate(180%);
    -webkit-backdrop-filter: blur(75px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 
      0 4px 16px rgba(0, 0, 0, 0.05),
      inset 0 1px 0 rgba(255, 255, 255, 0.3);
    border-radius: 12px;
  }

  .course-item__badge-value,
  .course-item__badge-label {
    color: #515151;
    font-size: 20px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .course-item__divider {
    height: 1px;
    background: rgba(0, 0, 0, 0.2);
  }
</style>

